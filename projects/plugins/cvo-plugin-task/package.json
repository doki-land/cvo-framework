{
    "name": "@cvo/plugin-task",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "CVO background task capability — queue bindings, cron, and inline dispatch manifests",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@cvo/core": "workspace:*",
        "@cvo/plugin": "workspace:*"
    },
    "keywords": [
        "cvo",
        "plugin",
        "task",
        "queue",
        "cron",
        "background"
    ]
}
