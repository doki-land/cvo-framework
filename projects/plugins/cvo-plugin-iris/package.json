{
    "name": "@cvo/plugin-iris",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "CVO Iris transport plugin — generated-call binding profiles for Workers (D1/gateway/WASM) and Node (N-API)",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@cvo/core": "workspace:*",
        "@cvo/plugin": "workspace:*"
    },
    "keywords": [
        "cvo",
        "plugin",
        "iris",
        "orm",
        "workers",
        "d1"
    ]
}
