{
    "name": "@cvo/plugin",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "CVO plugin protocol — definePlugin / defineConfig helpers (no Worker runtime)",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@cvo/core": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0"
    },
    "keywords": [
        "cvo",
        "plugin"
    ]
}
