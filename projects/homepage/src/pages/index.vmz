<script client>
import {
  brandShort,
  brandFull,
  navHome,
  navStack,
  navPrimary,
  homeAriaLabel,
  heroKicker,
  heroTitleA,
  heroTitleB,
  heroLede,
  heroCtaDocs,
  stackTitle,
  stackLede,
  stackVmz,
  stackCvo,
  stackIris,
  statusLabel,
  footerTagline,
  footerMeta,
} from '#locales/common';

export default class IndexPage {
  brandShort = '';
  brandFull = '';
  navHome = '';
  navStack = '';
  navPrimary = '';
  homeAriaLabel = '';
  heroKicker = '';
  heroTitleA = '';
  heroTitleB = '';
  heroLede = '';
  heroCtaDocs = '';
  stackTitle = '';
  stackLede = '';
  stackVmz = '';
  stackCvo = '';
  stackIris = '';
  statusLabel = '';
  footerTagline = '';
  footerMeta = '';

  onMount() {
    this.brandShort = brandShort();
    this.brandFull = brandFull();
    this.navHome = navHome();
    this.navStack = navStack();
    this.navPrimary = navPrimary();
    this.homeAriaLabel = homeAriaLabel();
    this.heroKicker = heroKicker();
    this.heroTitleA = heroTitleA();
    this.heroTitleB = heroTitleB();
    this.heroLede = heroLede();
