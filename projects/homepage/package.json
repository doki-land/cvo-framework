{
    "private": true,
    "name": "@cvo/homepage",
    "version": "0.0.0",
    "description": "CVO official site — VMZ static frontend (Cloudflare Pages)",
    "type": "module",
    "license": "MPL-2.0",
    "scripts": {
        "predev": "pnpm --filter @cvo/core --filter @cvo/server run build",
        "dev": "vmz dev . --out-dir dist/browser --target browser",
        "prebuild:client": "pnpm --filter @cvo/core --filter @cvo/server run build",
        "build:client": "vmz check . && vmz build . --release --profile static --out-dir dist/cdn --target browser",
        "prebuild:server": "pnpm --filter @cvo/core --filter @cvo/server run build",
        "build:server": "vmz check . && vmz build . --release --profile edge --out-dir dist/server --target browser",
        "build": "pnpm run build:client",
        "build:browser": "vmz build . --release --out-dir dist/browser --target browser",
        "check": "vmz check .",
        "serve": "vmz serve . --out-dir dist/browser"
    },
    "dependencies": {
        "@cvo/core": "workspace:*",
        "@vmz/core": "0.3.12",
        "@vmz/ui": "0.3.12",
        "@vmz/ui-icons": "0.3.12"
    },
    "devDependencies": {
        "@vmz/plugin": "0.3.12",
        "@vmz/vmz": "0.3.12",
        "typescript": "^5.8.3"
    }
}
